// The Clanker demo as a Cloudflare Worker serving the built app as static
// assets. Deploy with `npm run deploy:demo` from the repository root.
{
  "name": "glyf-clanker-demo",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
