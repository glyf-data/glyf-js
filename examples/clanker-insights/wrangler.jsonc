// The Clanker demo as a Cloudflare Worker serving the built app as static
// assets, at clanker.glyfdata.com. Deploy with `npm run deploy:demo` from the
// repository root. Each company demo gets its own Worker and subdomain.
{
  "name": "glyf-clanker-demo",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "clanker.glyfdata.com", "custom_domain": true }],
  // Only the glyfdata.com address: the workers.dev one names the account.
  "workers_dev": false,
  "preview_urls": false
}
