{
  "name": "@glyf-data/react",
  "version": "0.1.1",
  "description": "React components for glyf charts, KPI tiles, tables and filters, built on @glyf-data/embed.",
  "keywords": [
    "glyf",
    "dbt",
    "embedded-analytics",
    "react",
    "charts",
    "vega"
  ],
  "homepage": "https://github.com/glyf-data/glyf-js/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glyf-data/glyf-js.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/glyf-data/glyf-js/issues",
  "license": "MIT",
  "type": "module",
  "exports": {
